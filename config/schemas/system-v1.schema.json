{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-code-maintainer.invalid/schemas/system-v1.schema.json",
  "title": "Local Code Maintainer system configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment", "workflow", "qc", "protected_paths"],
  "properties": {
    "schema_version": { "const": 1 },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen_address", "data_root", "profile"],
      "properties": {
        "listen_address": { "type": "string", "minLength": 1, "maxLength": 255, "default": "127.0.0.1:8080" },
        "data_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "profile": { "enum": ["mock", "production"] }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_review_cycles", "max_wall_seconds", "max_log_bytes"],
      "properties": {
        "max_review_cycles": { "type": "integer", "minimum": 1, "maximum": 10, "default": 2 },
        "max_wall_seconds": { "type": "integer", "minimum": 60, "maximum": 604800, "default": 14400 },
        "max_log_bytes": { "type": "integer", "minimum": 1024, "maximum": 1073741824, "default": 8388608 }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block_on", "require_evidence_for_blocking", "require_verification_method", "human_waiver_enabled", "waiver_rationale_required"],
      "properties": {
        "block_on": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["blocker", "must_fix", "should_fix", "note"] },
          "default": ["blocker", "must_fix"]
        },
        "require_evidence_for_blocking": { "const": true },
        "require_verification_method": { "const": true },
        "human_waiver_enabled": { "type": "boolean", "default": true },
        "waiver_rationale_required": { "const": true }
      }
    },
    "protected_paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["patterns"],
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  }
}
